<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
            Debug builds only: an empty, internal host for the Compose instrumentation of roadmap P5 (the screens with fake
            or private model managers). It replaces the exported activity of ui-test-manifest, which the Manifest audit of
            ThreeMacawSpeechContractTest would refuse.
        -->
        <activity
            android:name=".ComposeTestHostActivity"
            android:exported="false" />
        <!--
            Debug builds only: the adb switch of the resident wake word for the device runs of roadmap P7.4 that must not be
            instrumented (.python/device_resident_run.py background|battery). Only holders of DUMP (adb, the system) start it.
        -->
        <activity
            android:name=".ResidentDebugActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!--
            Debug builds only: a hit of the running resident wake word from adb (roadmap P11.3.5), for the actions of the
            wake words in the background and on the lock screen. Only holders of DUMP (adb, the system) send it.
        -->
        <receiver
            android:name=".ResidentDebugHitReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
