<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="org.autojs.permission.PLUGIN" />

    <!--
        Roadmap D29: the plugin records audio itself (D6). The host binding with BIND_INCLUDE_CAPABILITIES (D22) lends it
        the microphone while AutoJs6 may record; for the time after that, every microphone session of a script holds the
        microphone foreground service MicrophoneService (appendix D Q5 (a), P3.1), as will the tryout screen and the
        1.1.0 assistant. FOREGROUND_SERVICE_DATA_SYNC keeps model downloads alive (roadmap P2.3, ModelOperationService).
        INTERNET only downloads models and refreshes the signed catalog; POST_NOTIFICATIONS shows download progress.
        No storage permission: models live in private storage and imports go through the system file picker (D23).
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Roadmap P5.1 (appendix D Q7): the home screen asks before a download on a metered network and waits offline. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The screens and the launcher entry are roadmap P5; the system TTS engine (roadmap P4.2) is below. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_icon_studio_application"
        android:roundIcon="@mipmap/ic_icon_studio_application"
        android:theme="@style/Theme.ThreeMacawSpeech">

        <!-- Every packaged sherpa-onnx, onnxruntime and Compose library is 16 KB aligned in all four ABIs (roadmap D14). -->
        <meta-data
            android:name="org.autojs.plugin.contract.NATIVE_PAGE_ALIGNMENT"
            android:value="16384" />

        <meta-data
            android:name="org.autojs.plugin.WAKE_ACTIVITY"
            android:value=".WakeActivity" />

        <meta-data
            android:name="org.autojs.plugin.info.AUTHOR"
            android:value="@string/plugin_author" />

        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT" />
                <action android:name="org.autojs.plugin.action.WAKE" />
            </intent-filter>
        </activity>

        <!--
            The plugin's screens (roadmap D7 / D26, P5). The home screen is the launcher target: the launcher entry is one
            of four fixed aliases that persist the icon choice as component state (icon specification section 4, roadmap
            P5.5); only the automatic alias is enabled by default. The home screen also answers INSTALL_TTS_DATA of the
            system TTS settings (it opens at the synthesis models), and the settings screen is the engine's settingsActivity
            (res/xml/tts_engine.xml), so both are exported without a permission: they only show the plugin's own screens.
        -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".launcher.AdaptiveLightIconAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_system_light"
            android:roundIcon="@mipmap/ic_launcher_system_light"
            android:targetActivity=".ui.home.HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.AdaptiveDarkIconAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_system"
            android:roundIcon="@mipmap/ic_launcher_system"
            android:targetActivity=".ui.home.HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.AdaptiveAutoIconAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_system_auto"
            android:roundIcon="@mipmap/ic_launcher_system_auto"
            android:targetActivity=".ui.home.HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.TransparentIconAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".ui.home.HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/settings_title" />
        <activity
            android:name=".ui.tryout.TryoutActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.release.ReleaseHistoryActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".ui.about.NoticesActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".ui.about.LegalDocumentActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />
        <!--
            The system voice input (roadmap P5.6, D41 - D47): a bottom sheet that answers ACTION_RECOGNIZE_SPEECH of any app
            (3-Stove Agent's microphone button, for one) with the recognized text only, so it is exported without a
            permission like the screen entries above. The settings screen disables the component (D43). It stays in the
            caller's task, which receives the result.
        -->
        <activity
            android:name=".ui.voice.VoiceInputActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.ThreeMacawSpeech.VoiceInput">
            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Package replacement repairs the launcher alias state only (no screen, network or model loading). -->
        <receiver
            android:name=".ui.appearance.LauncherIconUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Plugin Center identity (roadmap 5.5, category three-macaw-speech, engine speech). -->
        <service
            android:name=".service.ThreeMacawSpeechInfoService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <meta-data
                android:name="requiresHostVersion"
                android:value="@string/plugin_requires_host_version" />
            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="three-macaw-speech" />
            </intent-filter>
        </service>

        <!-- Speech capability (roadmap D21 / 5.5): ISpeechPlugin of contract version 1; models since P2.3, recognition P3, synthesis P4. -->
        <service
            android:name=".service.ThreeMacawSpeechService"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <meta-data
                android:name="requiresHostVersion"
                android:value="@string/plugin_requires_host_version" />
            <intent-filter>
                <action android:name="org.autojs.plugin.SPEECH" />
                <category android:name="speech" />
            </intent-filter>
        </service>

        <!-- Model downloads, imports and catalog refreshes (roadmap P2.3); internal, started by the plugin itself. -->
        <service
            android:name=".service.ModelOperationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Microphone sessions of scripts (roadmap P3.1, appendix D Q5 (a)); internal, started when a session opens. -->
        <service
            android:name=".service.MicrophoneService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- API 34+: starts MicrophoneService while the plugin is visible for a moment (roadmap P3.1); internal. -->
        <activity
            android:name=".service.MicrophoneStartActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The system dialog for RECORD_AUDIO that PERMISSION_DENIED names (a contract entry beside the home screen's button). -->
        <activity
            android:name=".service.MicrophonePermissionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
            The Android system TTS engine (roadmap D3, D19, P4.2, appendix C.2). It and the two activities below, besides the
            screens above, are the only exported components without the plugin permission: Android's TextToSpeech binds
            the engine from the client app's own process, and the system TTS settings start the activities. None of them
            has a side effect besides synthesis (voice check, sample text).
        -->
        <service
            android:name=".ttsengine.ThreeMacawSpeechTtsEngineService"
            android:exported="true"
            android:label="@string/app_name"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/tts_engine" />
        </service>

        <activity
            android:name=".ttsengine.CheckVoiceDataActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ttsengine.GetSampleTextActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.GET_SAMPLE_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>


    </application>

</manifest>
