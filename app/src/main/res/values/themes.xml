<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Window theme of the plugin's Compose screens (roadmap P5): no action bar, the neutral page background of the
        standalone settings specification (section 6); Compose draws everything else from MacawPalette.
    -->
    <style name="Theme.ThreeMacawSpeech" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/macaw_window_background</item>
        <item name="android:colorBackground">@color/macaw_window_background</item>
    </style>

    <!--
        The system voice input (roadmap P5.6): a transparent window over the caller's screen; the sheet draws its own scrim
        and slides in, so the window has no dim and no animation of its own.
    -->
    <style name="Theme.ThreeMacawSpeech.VoiceInput">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <color name="macaw_window_background">#F3F4F5</color>
</resources>
