<?xml version="1.0" encoding="utf-8"?>
<!-- The "Tap to speak" widget (roadmap D63): one round microphone button that opens the assistant sheet (D60). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_voice_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_voice_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/trigger_button_background"
        android:contentDescription="@string/widget_voice_label"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_mic_24"
        android:tint="@color/trigger_button_icon" />
</FrameLayout>
