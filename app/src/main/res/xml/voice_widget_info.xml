<?xml version="1.0" encoding="utf-8"?>
<!-- The "Tap to speak" widget (roadmap D63): one cell, no updates, no configuration. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_voice_description"
    android:initialLayout="@layout/widget_voice"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:previewImage="@drawable/widget_voice_preview"
    android:previewLayout="@layout/widget_voice"
    android:resizeMode="none"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="s" />
