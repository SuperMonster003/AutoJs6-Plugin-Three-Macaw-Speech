<?xml version="1.0" encoding="utf-8"?>
<!--
    The key trigger (roadmap P7.1, D64): key events only. No event types, no window content (D54), no gestures; the
    settings entry is the triggers group of the settings screen.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/key_service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="0"
    android:settingsActivity="io.github.supermonster003.autojs6.plugin.three.macaw.speech.ui.settings.TriggerSettingsAlias"
    android:summary="@string/key_service_summary"
    tools:targetApi="s" />
