<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Package visibility for the discovery queries of ThreeMacawSpeechContractTest on API 30+. -->
    <queries>
        <package android:name="io.github.supermonster003.autojs6.plugin.three.macaw.speech" />
    </queries>

    <!--
        Two test targets of the digital assistant (roadmap P5.7, D50): other apps that answer VOICE_COMMAND + DEFAULT. Their
        labels sort the other way round than their class names, so the sheet's label order shows. They run in the test
        package's own process and report what they received to the plugin process by broadcast.
    -->
    <application>
        <activity
            android:name="io.github.supermonster003.autojs6.plugin.three.macaw.speech.VoiceCommandTargetOne"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Macaw Test Target B"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="io.github.supermonster003.autojs6.plugin.three.macaw.speech.VoiceCommandTargetTwo"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Macaw Test Target A"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!--
            Another app's resident listener (roadmap P7.4, D75) for ResidentWakeDeviceTest: disabled until the test turns it on
            through the switch below; its settings entry is the second test target, which reports its start by broadcast.
        -->
        <service
            android:name="io.github.supermonster003.autojs6.plugin.three.macaw.speech.RivalResidentListener"
            android:enabled="false"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.speech.action.RESIDENT_LISTENER" />
            </intent-filter>
            <meta-data
                android:name="org.autojs.plugin.speech.RESIDENT_LISTENER_SETTINGS"
                android:value="io.github.supermonster003.autojs6.plugin.three.macaw.speech.VoiceCommandTargetTwo" />
        </service>
        <receiver
            android:name="io.github.supermonster003.autojs6.plugin.three.macaw.speech.RivalResidentListener$Switch"
            android:exported="true" />
    </application>
</manifest>
